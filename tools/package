#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -n 1)
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) platform=macos-arm64 ;;
  Darwin-x86_64) platform=macos-x86_64 ;;
  Linux-x86_64) platform=linux-x86_64 ;;
  *) echo 'No release packaging target for this platform' >&2; exit 1 ;;
esac
out="${1:-.validation/dist}"
mkdir -p "$out"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT HUP INT TERM
folder="stimma-drawthings-$version-$platform"
mkdir "$stage/$folder"
cp target/release/stimma-drawthings README.md LICENSE.md THIRD_PARTY_NOTICES.md THIRD_PARTY_LICENSES.md Cargo.lock "$stage/$folder/"
cp -R docs vendor "$stage/$folder/"
COPYFILE_DISABLE=1 tar -czf "$out/$folder.tar.gz" -C "$stage" "$folder"
(cd "$out" && shasum -a 256 "$folder.tar.gz" > "$folder.tar.gz.sha256")
echo "$out/$folder.tar.gz"
