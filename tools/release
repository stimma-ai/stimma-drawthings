#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -n 1)
test "$(git config user.email)" = 'stimmant@stimma.ai'
test -z "$(git status --porcelain)" || { echo 'Commit changes before releasing' >&2; exit 1; }
git tag -a "v$version" -m "Release v$version"
git push origin "v$version"
echo 'Release workflow started; verify its final result before announcing the release.'
